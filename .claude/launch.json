{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tiare-backend",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=127.0.0.1", "--port=8000"],
      "port": 8000
    },
    {
      "name": "tiare-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
