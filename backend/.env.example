APP_NAME=TIARE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- TIARE ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Prefijo de tokens API (facilita que escáneres de secretos los detecten si se filtran)
SANCTUM_TOKEN_PREFIX=tiare_
# Base de datos local MariaDB/MySQL (ver docs/DECISIONS.md TD-002)
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tiare
# DB_USERNAME=root
# DB_PASSWORD=

# Administrador inicial (solo desarrollo local; usa una contraseña propia)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Mercado Público (el ticket se configura SOLO en backend/.env) ---
MERCADO_PUBLICO_ENABLED=false
MERCADO_PUBLICO_TICKET=
MERCADO_PUBLICO_V2_BASE_URL=https://api2.mercadopublico.cl
MERCADO_PUBLICO_V1_BASE_URL=https://api.mercadopublico.cl/servicios/v1/publico
MERCADO_PUBLICO_V1_DAILY_BUDGET=9000
MERCADO_PUBLICO_V1_LIST_CACHE_MINUTES=30
MERCADO_PUBLICO_V1_BUYERS_REFRESH_HOURS=24
MERCADO_PUBLICO_V1_HTTP_TIMEOUT=45
# Cuota real observada del ticket V2 ≈ 275 solicitudes/día (14-11-2026). Ajustar según tu tipo de ticket.
MERCADO_PUBLICO_V2_DAILY_BUDGET=250
# Solicitudes diarias que la sincronización automática NO puede usar (quedan para fichas y acciones de las personas, TD-029)
MERCADO_PUBLICO_V2_INTERACTIVE_RESERVE=70
MERCADO_PUBLICO_V2_Z_IS_LOCAL=true
MERCADO_PUBLICO_SYNC_ENABLED=false
MERCADO_PUBLICO_SYNC_INTERVAL_MINUTES=60
MERCADO_PUBLICO_SYNC_OVERLAP_MINUTES=15
MERCADO_PUBLICO_SYNC_INITIAL_WINDOW_HOURS=24
MERCADO_PUBLICO_SYNC_MAX_WINDOW_HOURS=72
MERCADO_PUBLICO_SYNC_MAX_PAGES=10
# publications = solo publicaciones nuevas con reanudación (recomendado); changes = todos los cambios del país (caro)
MERCADO_PUBLICO_SYNC_MODE=publications
MERCADO_PUBLICO_SYNC_MANUAL_COOLDOWN_MINUTES=10
MERCADO_PUBLICO_HTTP_TIMEOUT=20
MERCADO_PUBLICO_HTTP_CONNECT_TIMEOUT=5
MERCADO_PUBLICO_MAX_RETRIES=2
# Vigencia de una ficha de detalle guardada: abiertas (minutos) y cerradas/finalizadas (horas)
MERCADO_PUBLICO_CACHE_MINUTES=60
MERCADO_PUBLICO_CLOSED_CACHE_HOURS=24

# --- Agentes IA (Fase 6). La clave vive solo aquí, en el servidor. ---
# Sin AI_ENABLED=true o sin clave, los agentes funcionan en modo determinista (sin modelo).
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_TOKENS=16000
AI_SERVER_SIDE_FALLBACK=true
AI_HTTP_TIMEOUT=120
AI_MAX_RETRIES=2
AI_DAILY_RUNS_PER_TENANT=30

# Búsquedas guardadas y alertas internas (usa datos ya sincronizados, no consume cuota).
MERCADO_PUBLICO_MATCHING_ENABLED=true
MERCADO_PUBLICO_MAX_SAVED_SEARCHES=20
# Licitaciones en búsquedas guardadas (API V1): cada N horas, 1 consulta de activas + hasta N detalles.
MERCADO_PUBLICO_TENDER_WATCH_ENABLED=true
MERCADO_PUBLICO_TENDER_WATCH_HOURS=3
MERCADO_PUBLICO_TENDER_DETAILS_PER_RUN=40
